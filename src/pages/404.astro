---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found — Jon Colon" description="This page doesn't exist.">
  <main style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;padding:2rem;text-align:center;font-family:'Space Grotesk',system-ui,sans-serif;">
    <p style="font-family:'JetBrains Mono',monospace;letter-spacing:.1em;opacity:.7;margin:0;">ERROR 404</p>
    <h1 style="font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(2.5rem,8vw,5rem);line-height:1;margin:0;">Page not found</h1>
    <p style="max-width:32rem;margin:0;">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" style="font-weight:700;text-decoration:underline;">← Back home</a>
  </main>
</BaseLayout>
